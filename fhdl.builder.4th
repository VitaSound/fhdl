\ fhdl.builder.4th
\ V3.1 - Unified List + Formatting fixes

require fhdl.structs.4th

\ ==========================================================
\ Глобальное состояние
\ ==========================================================

variable items-head
variable items-tail
variable current-module 

\ Хелперы
: (.) ( n -- addr u ) s>d <# #s #> ;
warnings off
: name ( "text" -- addr u ) parse-name ;
: value ( "text" -- addr u ) parse-name ;
warnings on

: reset-builder
    0 items-head ! 0 items-tail ! 
    0 current-module ! ;

\ ==========================================================
\ Конструкторы
\ ==========================================================

\ --- Инклюд ---
: include, ( path-addr path-u -- )
    include% allocate throw >r
    0 r@ inc.next !
    NODE_INCLUDE r@ inc.type !
    str-dup r@ inc.path-len ! r@ inc.path-addr !
    items-head items-tail r@ list-append
    r> drop
;

\ --- Модуль ---
: module, ( name-addr name-u -- )
    module% allocate throw >r
    0 r@ mod.next !
    NODE_MODULE r@ mod.type !
    str-dup r@ mod.name-len ! r@ mod.name-addr !
    
    0 r@ mod.params-head ! 0 r@ mod.params-tail !
    0 r@ mod.ports-head !  0 r@ mod.ports-tail !
    0 r@ mod.assigns-head ! 0 r@ mod.assigns-tail !
    
    items-head items-tail r@ list-append
    r> current-module !
;

\ --- Параметры ---
: (param-new) ( val-u val-a name-u name-a -- node-addr )
    current-module @ 0= IF true abort" Error: Parameter outside of module!" THEN
    param% allocate throw >r
    
    0 r@ param.next !
    0 r@ param.type !  \ <--- Добавляем инициализацию, раз поле есть в структуре
    
    str-dup r@ param.name-len ! r@ param.name-addr !
    str-dup r@ param.val-len !  r@ param.val-addr !
    current-module @ mod.params-head current-module @ mod.params-tail r@ list-append
    r> 
;

: parameter, ( val-addr val-u name-addr name-u -- )
    (param-new) 0 swap param.is-local ! ;

: localparam, ( val-addr val-u name-addr name-u -- )
    (param-new) 1 swap param.is-local ! ;

: param-int, ( n name-addr name-u -- )
    rot (.) 2swap parameter, ;


\ ==========================================================
\ Генераторы (Backend)
\ ==========================================================

: gen-include-node ( node-addr -- )
    >r
    ." `include " 
    [char] " emit
    r@ inc.path-addr @ r@ inc.path-len @ type
    [char] " emit
    cr
    r> drop
;

: gen-params ( mod-addr -- )
    dup mod.params-head @ 0= IF drop EXIT THEN
    
    cr \ Отступ перед параметрами
    mod.params-head @ 
    BEGIN dup WHILE ( node )
        dup >r
        ."      "
        r@ param.is-local @ IF ." localparam " ELSE ." parameter  " THEN
        r@ param.name-addr @ r@ param.name-len @ type
        ."  = "
        r@ param.val-addr @  r@ param.val-len @  type
        ." ;" cr
        r> param.next @
    REPEAT drop
;

: gen-module-node ( node-addr -- )
    >r
    cr s" module " type 
    r@ mod.name-addr @ r@ mod.name-len @ type
    s"  ( );" type cr
    
    r@ gen-params
    \ (тут будет вызов gen-ports и gen-assigns)
    
    s" endmodule" type cr cr  \ <--- ДОБАВЛЕНО: Два перевода строки для отступа после модуля
    r> drop
;

: generate-verilog, ( -- )
    items-head @ 0= IF cr s" [WARN] Nothing to generate." type cr EXIT THEN

    cr s" // Generated by FHDL V2 (Unified List)" type cr
    
    items-head @ 
    BEGIN dup WHILE ( node )
        dup >r
        
        r@ mod.type @ CASE 
            NODE_INCLUDE OF r@ gen-include-node ENDOF
            NODE_MODULE  OF r@ gen-module-node  ENDOF
        ENDCASE
        
        r> mod.next @
    REPEAT drop
;

\ ==========================================================
\ Очистка памяти
\ ==========================================================

: free-params ( mod-addr -- )
    mod.params-head @ BEGIN dup WHILE
        dup param.next @ >r
        dup param.name-addr @ over param.name-len @ str-free
        dup param.val-addr  @ over param.val-len  @ str-free
        free throw r>
    REPEAT drop ;

: free-module-node ( mod-addr -- )
    dup free-params
    dup mod.name-addr @ over mod.name-len @ str-free
    free throw ;

: free-include-node ( inc-addr -- )
    dup inc.path-addr @ over inc.path-len @ str-free
    free throw ;

: free-all ( -- )
    items-head @ 
    BEGIN dup WHILE ( node )
        dup mod.next @ >r 
        dup mod.type @ CASE
            NODE_MODULE  OF dup free-module-node  ENDOF
            NODE_INCLUDE OF dup free-include-node ENDOF
        ENDCASE
        r> 
    REPEAT drop
    reset-builder ;

: run-build ( addr u -- )
    reset-builder
    2dup file-status nip 0= IF
        \ Добавили // для совместимости вывода с Verilog файлом
        cr s" // [BUILDER] Parsing file: " type 2dup type cr
        ['] included catch dup IF cr s" // [ERROR] Parsing failed: " type . cr 2drop drop EXIT THEN drop
    ELSE cr s" // [ERROR] File not found: " type type cr THEN ;

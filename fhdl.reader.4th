\ reader.fs

\ Переменная, которая будет доступна в основной программе
2VARIABLE pkg-version

\ Устанавливаем значение по умолчанию
s" unknown" pkg-version 2!

\ ==========================================================
\ Вспомогательные слова
\ ==========================================================

\ Копируем строку из временного буфера файла в постоянную память (Dictionary)
: save-string ( addr u -- addr u )
    here >r       \ Сохраняем текущий указатель свободной памяти
    2dup r@ swap move \ Копируем строку туда
    dup allot     \ Сдвигаем указатель памяти на длину строки
    r> swap       \ Возвращаем адрес копии и длину
;

\ ==========================================================
\ Определяем слова, которые встретятся в package.4th
\ ==========================================================

\ Эти слова ничего не делают, просто позволяют пройти файл без ошибок
: forth-package ;
: end-forth-package ;

: key-value ( -- )
    parse-name \ Читаем имя ключа
    
    \ Проверяем, является ли ключ словом "version"
    s" version" COMPARE 0= IF
        \ Читаем значение, сохраняем в память и записываем в переменную
        parse-name save-string pkg-version 2!
    ELSE
        \ Если ключ другой, читаем значение и выбрасываем его
        parse-name 2drop
    THEN
;

: key-list ( -- )
    \ Игнорируем всё до конца строки (для сложных списков зависимостей)
    0 parse 2drop 
;

\ ==========================================================
\ Главное слово для загрузки
\ ==========================================================

: load-config ( -- )
    s" package.4th" 
    2dup file-status nip 0= IF
        \ Файл существует — исполняем его
        included
    ELSE
        \ Файла нет — просто удаляем имя файла со стека
        2drop 
    THEN
;

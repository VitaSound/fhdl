forth-package
    key-value name fhdl
    key-value version 0.1.0
    key-value license COPL
    key-value description fhdl
    key-value main fhdl.4th
    key-value fmix ~> 0.7
    key-value flint ~> 0.2
    key-value fcov ~> 0.3
    \ key-value dependencies_path_fmix
    \ key-list dependencies ftest git https://github.com/UA3MQJ/ftest.git tag 0.1.0
    \ key-list dependencies base64 1.0.0
    \ key-list dependencies f 0.2.4
    \ key-list dependencies ttester 1.2.1
    key-list dependencies f git https://github.com/VitaSound/f tag 0.2.4
    key-list dependencies ttester git https://github.com/VitaSound/ttester tag 1.2.1
end-forth-package